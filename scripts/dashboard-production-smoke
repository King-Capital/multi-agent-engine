#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: dashboard-production-smoke [--url URL] [--token TOKEN] [--env-file PATH] [--require-spa]

Runs a safe shadow/side-hustle MAE dashboard smoke against the API/UI surface.
This is intentionally additive: it creates a dashboard-visible smoke session for
full MAE testing evidence without replacing or cutting over current king-agents.

Checks:
  - /api/health returns ok with runtime fields (version, db, uptime_seconds)
  - SPA root returns HTML when --require-spa is set
  - unauthenticated protected API requests are rejected
  - bearer-auth PG session creation works when a token is supplied
  - bearer-auth event ingest works after the PG session exists
  - creates and completes a dashboard agent with work evidence, traces, token/cost rollup
  - finalizes the PG session so it is not left active
  - session list, per-session SSE replay, PG events, and history expose completed work

Environment defaults:
  MAE_DASHBOARD_URL      Dashboard base URL (preferred)
  DASHBOARD_URL          Alternate dashboard base URL (default: http://127.0.0.1:8400)
  MAE_API_TOKEN          Bearer token for authenticated API checks (preferred)
  MAE_DASHBOARD_TOKEN    Alternate bearer token env var (optional)
  DASHBOARD_TOKEN        Alternate bearer token env var (optional)
EOF
}

base_url="${MAE_DASHBOARD_URL:-${DASHBOARD_URL:-http://127.0.0.1:8400}}"
token="${MAE_API_TOKEN:-${MAE_DASHBOARD_TOKEN:-${DASHBOARD_TOKEN:-}}}"
require_spa=0
env_file=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --url) base_url="${2:?missing URL}"; shift 2 ;;
    --token) token="${2:?missing token}"; shift 2 ;;
    --env-file) env_file="${2:?missing env file}"; shift 2 ;;
    --require-spa) require_spa=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ -n "$env_file" ]]; then
  if [[ ! -f "$env_file" ]]; then
    echo "env file not found: $env_file" >&2
    exit 2
  fi
  set -a
  # shellcheck source=/dev/null
  source "$env_file"
  set +a
  base_url="${MAE_DASHBOARD_URL:-${DASHBOARD_URL:-$base_url}}"
  token="${MAE_API_TOKEN:-${MAE_DASHBOARD_TOKEN:-${DASHBOARD_TOKEN:-$token}}}"
fi

base_url="${base_url%/}"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

curl_json() {
  curl --fail --silent --show-error --max-time 10 "$@"
}

auth_args=()
if [[ -n "$token" ]]; then
  auth_args=(-H "Authorization: Bearer ${token}")
fi

assert_json_field() {
  local file="$1" expr="$2" label="$3"
  python3 - "$file" "$expr" "$label" <<'PY'
import json, sys
path, expr, label = sys.argv[1:]
with open(path, 'r', encoding='utf-8') as f:
    data = json.load(f)
if not eval(expr, {}, {'data': data}):
    raise SystemExit(f"assertion failed: {label}; payload={data!r}")
PY
}

echo "dashboard smoke: target=${base_url}"

health="$tmp_dir/health.json"
curl_json "$base_url/api/health" > "$health"
assert_json_field "$health" "data.get('status') == 'ok'" "/api/health status ok"
assert_json_field "$health" "'version' in data and 'db' in data and isinstance(data.get('uptime_seconds'), int)" "/api/health runtime fields"
echo "ok: /api/health $(tr -d '\n' < "$health")"

if [[ "$require_spa" -eq 1 ]]; then
  root_headers="$tmp_dir/root.headers"
  root_body="$tmp_dir/root.html"
  curl --fail --silent --show-error --max-time 10 -D "$root_headers" "$base_url/" -o "$root_body"
  grep -qi '<html' "$root_body"
  echo "ok: SPA root served html"
fi

unauth_status="$(curl --silent --show-error --max-time 10 -o /dev/null -w '%{http_code}' "$base_url/api/sessions")"
if [[ "$unauth_status" != "401" ]]; then
  echo "expected /api/sessions without auth to return 401, got ${unauth_status}" >&2
  exit 1
fi
echo "ok: protected API rejects unauthenticated requests"

if [[ -z "$token" ]]; then
  echo "skip: authenticated PG/event/SSE checks (set MAE_API_TOKEN, MAE_DASHBOARD_TOKEN, DASHBOARD_TOKEN, or --token)"
  exit 0
fi

session_id="$(python3 - <<'PY'
import uuid
print(uuid.uuid4())
PY
)"
timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
session_payload="$tmp_dir/session.json"
payload="$tmp_dir/event.json"
cat > "$session_payload" <<EOF
{
  "id": "${session_id}",
  "name": "MAE shadow side-hustle smoke ${session_id}",
  "platform": "multi-agent-engine",
  "team": "shadow-smoke",
  "chain": "dashboard-production-smoke",
  "config": {
    "source": "scripts/dashboard-production-smoke",
    "shadow_only": true,
    "expected_final_status": "completed"
  }
}
EOF

curl_json -X POST "$base_url/api/pg/sessions/" \
  "${auth_args[@]}" \
  -H "Content-Type: application/json" \
  --data-binary "@$session_payload" > "$tmp_dir/post-session.json"
assert_json_field "$tmp_dir/post-session.json" "data.get('id') == '${session_id}'" "pg session create id"
echo "ok: pg session created ${session_id}"

cat > "$payload" <<EOF
{
  "session_id": "${session_id}",
  "agent_id": "smoke-orchestrator",
  "event_type": "session_start",
  "timestamp": "${timestamp}",
  "data": {
    "session_name": "MAE shadow side-hustle smoke ${session_id}",
    "task_prompt": "shadow-only MAE smoke: verify current king-agents dashboard behavior without replacement or cutover"
  }
}
EOF

curl_json -X POST "$base_url/api/events" \
  "${auth_args[@]}" \
  -H "Content-Type: application/json" \
  --data-binary "@$payload" > "$tmp_dir/post-event.json"
assert_json_field "$tmp_dir/post-event.json" "data.get('status') == 'ok'" "event ingest status"
echo "ok: event ingest created ${session_id}"

cat > "$tmp_dir/agent.json" <<EOF
{
  "agent_id": "smoke-worker",
  "role": "dashboard-smoke-verifier",
  "adapter": "script",
  "status": "running",
  "prompt": "Verify dashboard health/auth/session/event/SSE/history and record completed shadow smoke evidence.",
  "config": {"shadow_only": true, "work_evidence": "script performed live health/auth/session/event/SSE/history API checks"}
}
EOF
curl_json -X POST "$base_url/api/pg/sessions/${session_id}/agents" \
  "${auth_args[@]}" \
  -H "Content-Type: application/json" \
  --data-binary "@$tmp_dir/agent.json" > "$tmp_dir/post-agent.json"
agent_db_id="$(python3 - "$tmp_dir/post-agent.json" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding='utf-8'))['id'])
PY
)"
echo "ok: pg agent created id=${agent_db_id}"

for direction in input output; do
  content="dashboard-production-smoke ${direction}: live shadow smoke for ${session_id}"
  if [[ "$direction" == "output" ]]; then
    content="dashboard-production-smoke output: health/auth/session/event/SSE checks passed; finalizing completed session ${session_id}"
  fi
  python3 - "$session_id" "$direction" "$content" > "$tmp_dir/trace-${direction}.json" <<'PY'
import json, sys
session_id, direction, content = sys.argv[1:]
print(json.dumps({
  "session_id": session_id,
  "agent_id": "smoke-worker",
  "direction": direction,
  "content": content,
  "metadata": {"shadow_only": True, "source": "scripts/dashboard-production-smoke"},
}))
PY
  curl_json -X POST "$base_url/api/traces" \
    "${auth_args[@]}" \
    -H "Content-Type: application/json" \
    --data-binary "@$tmp_dir/trace-${direction}.json" > "$tmp_dir/post-trace-${direction}.json"
done
echo "ok: pg traces created"

completion_timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
cat > "$tmp_dir/cost-event.json" <<EOF
{
  "session_id": "${session_id}",
  "agent_id": "smoke-worker",
  "event_type": "cost_update",
  "timestamp": "${completion_timestamp}",
  "data": {
    "agent_id": "smoke-worker",
    "agent_db_id": ${agent_db_id},
    "model": "script-smoke",
    "tokens_used": 128,
    "cost_usd": 0.000128,
    "work_evidence": "live dashboard API smoke completed health/auth/session/event/SSE/history checks",
    "synthetic_cost_note": "nominal nonzero smoke rollup value for dashboard verification; no paid model call was made"
  }
}
EOF
curl_json -X POST "$base_url/api/events" \
  "${auth_args[@]}" \
  -H "Content-Type: application/json" \
  --data-binary "@$tmp_dir/cost-event.json" > "$tmp_dir/post-cost-event.json"
assert_json_field "$tmp_dir/post-cost-event.json" "data.get('status') == 'ok'" "cost event ingest status"

cat > "$tmp_dir/agent-done.json" <<EOF
{
  "status": "completed",
  "result": {
    "summary": "dashboard-production-smoke completed live shadow API checks",
    "checks": ["health", "auth_rejection", "pg_session", "event_ingest", "agent", "traces", "sse_replay", "pg_events", "history_rollup"],
    "tokens_used": 128,
    "cost_usd": 0.000128,
    "shadow_only": true
  },
  "cost_usd": 0.000128
}
EOF
curl_json -X PATCH "$base_url/api/pg/agents/${agent_db_id}" \
  "${auth_args[@]}" \
  -H "Content-Type: application/json" \
  --data-binary "@$tmp_dir/agent-done.json" > "$tmp_dir/patch-agent.json"
assert_json_field "$tmp_dir/patch-agent.json" "data.get('status') == 'completed' and data.get('cost_usd', 0) > 0" "agent completed with cost"
echo "ok: pg agent completed with work evidence/tokens/cost"

printf '{"status":"completed"}' > "$tmp_dir/session-done.json"
curl_json -X PATCH "$base_url/api/pg/sessions/${session_id}" \
  "${auth_args[@]}" \
  -H "Content-Type: application/json" \
  --data-binary "@$tmp_dir/session-done.json" > "$tmp_dir/patch-session.json"
assert_json_field "$tmp_dir/patch-session.json" "data.get('status') == 'completed' and data.get('completed_at')" "session completed"
echo "ok: pg session completed"

curl_json "$base_url/api/sessions" \
  "${auth_args[@]}" > "$tmp_dir/sessions.json"
python3 - "$tmp_dir/sessions.json" "$session_id" <<'PY'
import json, sys
sessions = json.load(open(sys.argv[1], encoding='utf-8'))
sid = sys.argv[2]
if not any(s.get('id') == sid for s in sessions):
    raise SystemExit(f"smoke session {sid} missing from /api/sessions")
PY
echo "ok: session list includes smoke session"

sse="$tmp_dir/session.sse"
curl --fail --silent --show-error --max-time 3 -N \
  "$base_url/api/sessions/${session_id}/stream" \
  "${auth_args[@]}" > "$sse" || true
if ! grep -q "$session_id" "$sse"; then
  echo "expected SSE replay to include ${session_id}; got:" >&2
  cat "$sse" >&2
  exit 1
fi
echo "ok: session SSE replay includes smoke session"

curl_json "$base_url/api/pg/sessions/${session_id}/events" \
  "${auth_args[@]}" > "$tmp_dir/pg-events.json"
python3 - "$tmp_dir/pg-events.json" "$session_id" <<'PY'
import json, sys
events = json.load(open(sys.argv[1], encoding='utf-8'))
sid = sys.argv[2]
if not any(e.get('session_id') == sid for e in events):
    raise SystemExit(f"smoke session {sid} missing from PG events")
if not any(e.get('event_type') == 'cost_update' and (e.get('payload') or {}).get('data', {}).get('tokens_used', 0) > 0 for e in events):
    raise SystemExit(f"smoke session {sid} missing cost_update token evidence")
PY
echo "ok: pg session events include smoke session and cost/token evidence"

curl_json "$base_url/api/pg/history?limit=50" \
  "${auth_args[@]}" > "$tmp_dir/history.json"
python3 - "$tmp_dir/history.json" "$session_id" <<'PY'
import json, sys
history = json.load(open(sys.argv[1], encoding='utf-8'))
sid = sys.argv[2]
matches = [h for h in history if h.get('id') == sid]
if not matches:
    raise SystemExit(f"smoke session {sid} missing from history")
h = matches[0]
if h.get('status') != 'completed' or not h.get('completed_at'):
    raise SystemExit(f"smoke session {sid} not completed in history: {h!r}")
if float(h.get('total_cost') or 0) <= 0 or int(h.get('total_tokens') or 0) <= 0:
    raise SystemExit(f"smoke session {sid} missing history cost/tokens: {h!r}")
print(f"history_status={h['status']} total_cost={h['total_cost']} total_tokens={h['total_tokens']} agent_count={h['agent_count']}")
PY
echo "dashboard smoke: PASS session_id=${session_id}"
